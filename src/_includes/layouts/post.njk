---
layout: layouts/base.njk
ogType: article
nav: blog
---
<article class="section post">
  <div class="container article-container">
    <a class="back-link" href="/blog/" data-umami-event="Back To Blog Click">&larr; Back to blog</a>

    <header class="post-header">
      <p class="post-eyebrow">Software blog</p>
      <h1>{{ title }}</h1>
      {% if description %}
        <p class="post-summary">{{ description }}</p>
      {% endif %}
      <div class="post-meta">
        <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
        {% if updated %}
          <span aria-hidden="true">·</span>
          <span>Updated <time datetime="{{ updated | htmlDateString }}">{{ updated | readableDate }}</time></span>
        {% endif %}
      </div>
      {% if tags %}
        <ul class="tag-list" aria-label="Post tags">
          {% for tag in tags %}
            <li><a class="tag" href="{{ tag | tagUrl }}">{{ tag }}</a></li>
          {% endfor %}
        </ul>
      {% endif %}
    </header>

    <div class="post-content">
      {{ content | safe }}
    </div>
  </div>
</article>
